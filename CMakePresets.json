{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "build/Debug",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CPM_SOURCE_CACHE": "~/.cache/CPM",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "binaryDir": "build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vs2022",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "build/VisualStudio2022"
    },
    {
      "name": "vs",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "build/VisualStudio2026"
    },
    {
      "name": "xcode",
      "generator": "Xcode",
      "binaryDir": "build/Xcode"
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "vs2022",
      "configurePreset": "vs2022"
    },
    {
      "name": "vs",
      "configurePreset": "vs"
    },
    {
      "name": "xcode",
      "configurePreset": "xcode"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "configurePreset": "release"
    },
    {
      "name": "vs2022",
      "inherits": "default",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "vs",
      "inherits": "default",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "xcode",
      "inherits": "default",
      "configurePreset": "xcode",
      "configuration": "Debug"
    }
  ]
}
